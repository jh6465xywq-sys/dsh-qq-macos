+/**
+ * 腾讯系静态资源 CDN 域名。这些 host 由腾讯控制、只提供图片/文件下载，
+ * 允许在「代理 fake-ip 导致解析到保留段」时仍然放行。
+ * 注意：只放行域名后缀，不放行任意 IP 直连。
+ */
+const TRUSTED_CDN_SUFFIXES = ['qpic.cn', 'qq.com', 'qq.com.cn', 'gtimg.cn', 'myqcloud.com', 'qcloudimg.com'];
+
+export function isTrustedCdnHost(hostname) {
+  const h = String(hostname || '').toLowerCase().replace(/\.$/, '');
+  if (!h) return false;
+  return TRUSTED_CDN_SUFFIXES.some((suffix) => h === suffix || h.endsWith(`.${suffix}`));
+}
+
 /** 解析主机名并校验**全部**解析结果，返回可尝试的地址列表（IPv4 优先）。 */
 export async function resolveSafeAddresses(hostname) {
   const h = String(hostname || '').toLowerCase().replace(/^\[|\]$/g, '').replace(/\.$/, '');
@@ -150,8 +163,13 @@ export async function resolveSafeAddresses(hostname) {
