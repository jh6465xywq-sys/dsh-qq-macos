# 复制成 .env 再填。这个文件不会被提交。

# ---------- 你的小号（机器人用的那个 QQ） ----------
BOT_QQ=1000000001

# ---------- 你本人（只有这个号能和它私聊） ----------
OWNER_QQ=1000000002

# ---------- SnowLuma / OneBot ----------
# HTTP 和 WS 的 accessToken 必须设成同一个值（原因见 docs/99-踩坑总表.md D1）
ONEBOT_TOKEN=change-me-to-a-random-string
ONEBOT_HTTP=http://127.0.0.1:3000
ONEBOT_WS=ws://127.0.0.1:3001

# ---------- noVNC 扫码用 ----------
VNC_PASSWD=change-me-8-chars

# ---------- DSH ----------
# 端口每次重启都会变，用 scripts/find-dsh-port.py 探测
DSH_BASE_URL=http://127.0.0.1:0000
DSH_API_KEY=

# ---------- 控制台 ----------
CONSOLE_TOKEN=change-me

# ---------- 可选：长期记忆（embedding） ----------
# 硅基流动有免费额度；不想用云端可以本机 ollama
EMBEDDING_BASE=https://api.siliconflow.cn/v1
EMBEDDING_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 可选：语音 ----------
TTS_ENGINE=say          # say | gptsovits | doubao
TTS_API_BASE=http://127.0.0.1:9880
